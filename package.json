{
  "name": "universal-nvm",
  "description": "nvm: a universal node.js version manager for Windows (no admin) and Unix",
  "version": "1.12.1",
  "author": "Tom.Huang <hzlhu.dargon@gmail.com>",
  "contributors": [
    "Joel Chen <joel123@gmail.com>"
  ],
  "main": "install.sh",
  "license": "MIT",
  "scripts": {
    "build": "webpack",
    "test:run": "vitest run",
    "test": "xrun -s build test:run",
    "test:unit": "xrun -s build && vitest run --exclude 'test/e2e/**'",
    "test:e2e": "xrun -s build && vitest run test/e2e",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:dist": "xrun check-dist",
    "preversion": "echo Do not run npm version, run xrun version --major,minor,patch && exit 1",
    "prepublishOnly": "echo Do not run npm publish, run xrun release && exit 1",
    "preinstall": "node bin/no-npm-install.js",
    "coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "prettier": {
    "printWidth": 100
  },
  "dependencies": {
    "chalker": "^1.3.1",
    "lodash": "^4.18.1",
    "needle": "^3.5.0",
    "nix-clap": "^1.3.13",
    "node-stream-zip": "^1.16.0",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "xaa": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "@xarc/module-dev": "^5.0.0",
    "@xarc/run": "^2.3.0",
    "babel-loader": "^10.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11",
    "webpack": "^5.110.0",
    "webpack-bundle-analyzer": "^5.3.2",
    "webpack-cli": "^7.2.2",
    "zipit": "^2.0.0"
  },
  "keywords": [
    "Node",
    "version",
    "manager",
    "unix",
    "*nix",
    "windows",
    "nvm",
    "windows nvm",
    "nvm windows",
    "no admin nvm",
    "universal",
    "universal nvm"
  ],
  "files": [
    "bin",
    "dist/unvm.js",
    "dist/unvm.js.LICENSE.txt",
    "install.sh",
    "install.ps1"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchip/universal-nvm.git"
  }
}
